QWidget {
    background-color: #f8fafc;
    color: #1e293b;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}
QMainWindow {
    background-color: #ffffff;
}
#MainTitle {
    font-size: 28px;
    font-weight: bold;
    color: #0f172a;
    margin-bottom: 8px;
}
#Subtitle {
    font-size: 16px;
    color: #64748b;
    margin-bottom: 24px;
}
#StatusLabel {
    font-size: 14px;
    color: #475569;
    font-style: italic;
}
#MainInput {
    padding: 12px;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    background-color: #ffffff;
    font-size: 16px;
}
#MainInput:focus {
    border: 2px solid #2563eb;
}
#PrimaryButton {
    background-color: #2563eb;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
}
#PrimaryButton:hover {
    background-color: #1d4ed8;
}
#PrimaryButton:pressed {
    background-color: #1e40af;
}
#SecondaryButton {
    background-color: #f1f5f9;
    color: #334155;
    font-weight: bold;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
}
#SecondaryButton:hover {
    background-color: #e2e8f0;
    border-color: #94a3b8;
}
QTabWidget::pane {
    border: 1px solid #cbd5e1;
    background-color: white;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background-color: #f1f5f9;
    color: #64748b;
    padding: 12px 24px;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background-color: white;
    color: #2563eb;
    font-weight: bold;
    border-bottom: 2px solid white;
}
QTableWidget {
    background-color: white;
    gridline-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}
QHeaderView::section {
    background-color: #1e293b;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
}
QProgressBar {
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    text-align: center;
    height: 8px;
}
QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}
